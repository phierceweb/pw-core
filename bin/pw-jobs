#!/usr/bin/env python3
"""pw-jobs — admin CLI for the pw-core jobs table.

Thin shim over :mod:`pw_core.cli.jobs`. Consumers can skip this script
entirely by mounting the same sub-app inside their own CLI::

    from pw_core.cli.jobs import app as jobs_app
    my_app.add_typer(jobs_app, name="jobs")

Commands::

    pw-jobs list [--kind X] [--status Y] [--since 24h] [--limit 20]
    pw-jobs show <id>
    pw-jobs retry <id>
    pw-jobs cancel <id> [--reason "..."]
    pw-jobs reclaim [--lease-seconds 300]
    pw-jobs purge --older-than 90d [--status succeeded]
"""

from __future__ import annotations

from pw_core.cli import create_cli, run_cli
from pw_core.cli.jobs import app as jobs_app

app = create_cli("pw-jobs", help="Admin CLI for pw-core jobs.")

# Flatten the sub-app's commands onto the top-level `pw-jobs <cmd>` namespace
# so existing invocations (``pw-jobs list``) keep working.
for command in jobs_app.registered_commands:
    app.registered_commands.append(command)


def main() -> None:
    run_cli(app)


if __name__ == "__main__":
    main()
