#!/usr/bin/env python3
"""Scaffold a new pw-core consumer project.

    bin/new-consumer <name> --layout {lib|app} [--extras cli,llm] [--base-only] [--dest DIR]

Stamps a runnable, conformant project: a `pyproject.toml` pinning pw-foundation and pw-core
(at this checkout's version) with the chosen extras, `bin/` wrappers, the layout's skeleton,
`.ai/` stubs (the starter rules arrive from `pw-setup` at `bin/setup`), and a day-1 vertical
slice so `bin/run` works immediately after `bin/setup`.

`--base-only` (lib layout) depends on pw-foundation alone. A template file with a base-only
twin — `x_base.py` beside `x.py`, `X.base.md` beside `X.md` — is replaced by that twin, so the
generated project says only what is true of pw-foundation.

This is a from-checkout dev tool — it reads `templates/` from the pw-core source tree (they are
not shipped in the wheel). The *generated* project depends on the framework via PyPI pins.
"""

from __future__ import annotations

import argparse
import re
import sys
import tomllib
from pathlib import Path

PW_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_EXTRAS = {"lib": "cli", "app": "full"}
BASE_PIN = "pw-foundation~=1.0"
_BASE_TWIN = re.compile(r"^(?P<stem>.+?)(?:_base(?P<py>\.py)|\.base(?P<ext>\.[A-Za-z]+))$")


def core_pin(extras: str) -> str:
    """pw-core at this checkout's version, so a version bump moves the scaffold with it."""
    meta = tomllib.loads((PW_ROOT / "pyproject.toml").read_text(encoding="utf-8"))
    return f"pw-core[{extras}]~={meta['project']['version']}"


def _twin_name(name: str) -> str | None:
    """`cli_base.py` -> `cli.py`, `CLAUDE.base.md` -> `CLAUDE.md`; None when not a base-only twin."""
    m = _BASE_TWIN.match(name)
    return None if m is None else m["stem"] + (m["py"] or m["ext"])


def _pkg_name(name: str) -> str:
    pkg = name.strip().lower().replace("-", "_").replace(" ", "_")
    if not pkg.isidentifier():
        sys.exit(f"error: {name!r} does not yield a valid package name ({pkg!r})")
    return pkg


def _substitute(text: str, tokens: dict[str, str]) -> str:
    for token, value in tokens.items():
        text = text.replace(token, value)
    return text


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="new-consumer", description="Scaffold a pw-core consumer.")
    p.add_argument("name", help="Project / distribution name, e.g. my-tool.")
    p.add_argument(
        "--layout",
        choices=("lib", "app"),
        required=True,
        help="lib = CLI/library (src-layout); app = FastAPI + DB (app-layout).",
    )
    p.add_argument(
        "--extras",
        default=None,
        help="pw-core extras, comma-separated. Default: cli (lib) / full (app).",
    )
    p.add_argument(
        "--base-only",
        action="store_true",
        help="lib only: depend on pw-foundation alone (no pw-core, argparse CLI).",
    )
    p.add_argument(
        "--dest",
        default=".",
        help="Parent directory to create the project in (default: cwd).",
    )
    args = p.parse_args(argv)

    if args.base_only and args.layout != "lib":
        p.error("--base-only applies to --layout lib (an app needs pw-core)")
    name = args.name.strip()
    pkg = _pkg_name(name)
    extras = args.extras or DEFAULT_EXTRAS[args.layout]
    siblings = ["pw-foundation"] + ([] if args.base_only else ["pw-core"])
    pins = [BASE_PIN] + ([] if args.base_only else [core_pin(extras)])
    note = "pw-foundation is 1.x (minor releases are additive)"
    if not args.base_only:
        note += "; the pw-core pin takes patch releases only"
    deps = "\n".join([f"    # {note}.", *(f'    "{pin}",' for pin in pins)])
    tokens = {
        "__NAME__": name,
        "__PKG__": pkg,
        "__EXTRAS__": extras,
        '    "__DEPS__",': deps,
        "__SIBLINGS__": " ".join(siblings),
        "__DOCS_LINKS__": "\n".join(f"docs/{s}" for s in siblings),
    }
    template = PW_ROOT / "templates" / f"consumer-{args.layout}"
    if not template.is_dir():
        sys.exit(f"error: template not found: {template}")

    dest = Path(args.dest).resolve() / name
    if dest.exists() and any(dest.iterdir()):
        sys.exit(f"error: {dest} already exists and is not empty")

    # 1. Stamp the template — substitute tokens in both content and path.
    skip_dirs = {"__pycache__", ".ruff_cache", ".pytest_cache", ".mypy_cache"}
    for src in sorted(template.rglob("*")):
        if src.is_dir() or skip_dirs.intersection(src.parts) or src.suffix == ".pyc":
            continue
        twin = _twin_name(src.name)
        if twin is not None:
            if not args.base_only:
                continue
        elif args.base_only and any(_twin_name(s.name) == src.name for s in src.parent.iterdir()):
            continue  # replaced by its base-only twin
        rel_parts = [part.replace("__PKG__", pkg) for part in src.relative_to(template).parts]
        if twin is not None:
            rel_parts[-1] = twin
        out = dest.joinpath(*rel_parts)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(_substitute(src.read_text(encoding="utf-8"), tokens), encoding="utf-8")
        if rel_parts[0] == "bin":
            out.chmod(0o755)

    # 2. Stub .ai/. The starter rules arrive from `pw-setup` (pw-foundation's seven, plus
    #    pw-core's three when pw-core is installed), which bin/setup runs.
    (dest / ".ai" / "rules").mkdir(parents=True, exist_ok=True)
    for d in ("plans", "docs", "scripts"):
        sub = dest / ".ai" / d
        sub.mkdir(parents=True, exist_ok=True)
        (sub / ".gitkeep").touch()

    print(f"✓ scaffolded {args.layout} project at {dest}")
    print(f"  package: {pkg}   depends on: {', '.join(pins)}")
    print("\nNext:")
    print(f"  cd {dest}")
    print("  bin/setup")
    print("  bin/run pw-doctor")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
