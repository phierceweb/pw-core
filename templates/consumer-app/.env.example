# __NAME__ environment. Copy to .env (bin/setup does this for you).
#
# DATABASE_URL, WEB_*, the API keys and the other pw-core settings are listed in
# docs/pw-core/config.md; LOG_LEVEL and LOG_FILE are pw-foundation's (docs/pw-foundation/logging.md).

# DATABASE_URL=               # empty = no DB; SQLite needs no driver extra
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# LOG_LEVEL=INFO
