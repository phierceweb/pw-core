#!/usr/bin/env bash
# Bootstrap __NAME__: venv (Python 3.12+), editable install, .env, framework wiring (pw-setup).
# A sibling checkout of a framework package (../<package>) is preferred when present.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
ok()   { echo "  ✓ $*"; }
info() { echo "  $*"; }

pick_python() {
  local p
  for p in python3.13 python3.12 python3; do
    p="$(command -v "$p" 2>/dev/null || true)"
    [[ -n "$p" ]] || continue
    if "$p" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
      echo "$p"; return 0
    fi
  done
  echo "No Python 3.12+ found. Install 3.12+ (e.g. brew install python@3.12)." >&2
  exit 1
}

if [[ ! -d .venv ]]; then
  PY="$(pick_python)"
  info "Creating .venv ($("$PY" --version | tr -d '\r'))"
  "$PY" -m venv .venv
  ok ".venv created"
else
  if ! .venv/bin/python -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
    echo "__NAME__ requires Python 3.12+. Your .venv uses an older interpreter." >&2
    echo "  rm -rf .venv && bin/setup" >&2
    exit 1
  fi
  ok ".venv exists ($(.venv/bin/python --version | tr -d '\r'))"
fi

.venv/bin/python -m pip install --quiet --upgrade pip
# A sibling framework checkout wins over PyPI: co-development, or a release not yet published.
for sib in __SIBLINGS__; do
  if [[ -f "$ROOT/../$sib/pyproject.toml" ]]; then
    info "Installing $sib editable from ../$sib"
    .venv/bin/python -m pip install --quiet -e "$ROOT/../$sib"
  fi
done
info "Installing __NAME__ (editable, with dev extras)"
.venv/bin/python -m pip install --quiet -e ".[dev]"
ok "dependencies installed"

# pw-setup (pw-foundation) links the framework docs under docs/, installs the starter
# rules into .ai/rules/ and points .claude/ and .cursor/ at .ai/. It owns that wiring.
if [[ ! -x .venv/bin/pw-setup ]]; then
  echo "pw-setup not found in .venv/bin — pw-foundation is missing from the install" >&2
  exit 1
fi
.venv/bin/pw-setup
ok "pw-setup ran"

if [[ -f .env.example && ! -f .env ]]; then
  cp .env.example .env
  ok "copied .env.example -> .env"
fi

# Ensure the structural-gate config exists (stamped by the scaffold; self-heals).
if [[ ! -f .pw-guards.toml ]]; then
  printf '[tool.pw_guards]\nroot = "app"\n' > .pw-guards.toml
  ok "created .pw-guards.toml"
fi

# Install the commit gates (structural gate + ruff) when this is a git repo.
if [[ -d .git && -x .venv/bin/pre-commit ]]; then
  .venv/bin/pre-commit install >/dev/null
  ok "pre-commit hooks installed (gate runs on every commit)"
else
  info "not a git repo yet — run 'git init && .venv/bin/pre-commit install' to enable the commit gates"
fi

echo
echo "Setup complete."
echo "  bin/run pw-doctor   # attest the install"
echo "  bin/web             # start the server, then open http://127.0.0.1:8000/"
